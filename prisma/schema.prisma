generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id              Int      @id @default(autoincrement())
  placeId         String   @unique @map("place_id")
  businessName    String   @map("business_name")
  category        String?
  formattedAddress String? @map("formatted_address")
  phoneNumber     String?  @map("phone_number")
  email           String?
  emailSource     String?  @map("email_source")
  emailStatus     String?  @map("email_status")
  emailCheckedAt  DateTime? @map("email_checked_at")
  websiteUrl      String?  @map("website_url")
  googleMapsUrl   String?  @map("google_maps_url")
  rating          Float?
  reviewCount     Int?     @map("review_count")
  businessStatus  String?  @map("business_status")
  openingHours    String?  @map("opening_hours")
  searchKeyword   String   @map("search_keyword")
  searchLocation  String   @map("search_location")
  source          String   @default("serper_places_api")
  collectedAt     DateTime @map("collected_at")
  lastRefreshedAt DateTime? @map("last_refreshed_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  emailLogs       EmailLog[]
  smsLogs         SmsLog[]

  @@index([searchKeyword])
  @@index([searchLocation])
  @@index([category])
  @@map("leads")
}

model SearchJob {
  id              Int       @id @default(autoincrement())
  searchKeyword   String    @map("search_keyword")
  searchLocation  String    @map("search_location")
  searchType      String    @map("search_type")
  status          String
  totalFound      Int       @default(0) @map("total_found")
  totalSaved      Int       @default(0) @map("total_saved")
  totalDuplicates Int       @default(0) @map("total_duplicates")
  errorMessage    String?   @map("error_message")
  startedAt       DateTime  @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  @@index([status])
  @@map("search_jobs")
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  ipAddress String   @map("ip_address")
  path      String
  method    String
  decision  String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([decision])
  @@index([createdAt])
  @@map("access_logs")
}

model ApiErrorLog {
  id             Int      @id @default(autoincrement())
  provider       String
  endpoint       String?
  errorCode      String?  @map("error_code")
  errorMessage   String?  @map("error_message")
  requestContext String?  @map("request_context")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([provider])
  @@map("api_error_logs")
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model EmailLog {
  id           Int      @id @default(autoincrement())
  leadId       Int?     @map("lead_id")
  businessName String   @map("business_name")
  email        String
  status       String
  subject      String?
  body         String?
  errorMessage String?  @map("error_message")
  sentAt       DateTime @default(now()) @map("sent_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([sentAt])
  @@index([status])
  @@map("email_logs")
}

model SmsLog {
  id                Int      @id @default(autoincrement())
  leadId            Int?     @map("lead_id")
  businessName      String   @map("business_name")
  phone             String
  status            String
  provider          String?
  body              String?
  providerMessageId String?  @map("provider_message_id")
  deliveryStatus    String?  @map("delivery_status")
  deliveryError     String?  @map("delivery_error")
  deliveryReceipt   String?  @map("delivery_receipt")
  deliveredAt       DateTime? @map("delivered_at")
  errorMessage      String?  @map("error_message")
  sentAt            DateTime @default(now()) @map("sent_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([sentAt])
  @@index([status])
  @@index([deliveryStatus])
  @@map("sms_logs")
}

model CsvImport {
  id          Int               @id @default(autoincrement())
  fileName    String            @map("file_name")
  importedAt  DateTime          @default(now()) @map("imported_at")
  leads       ImportedCsvLead[]

  @@index([importedAt])
  @@map("csv_imports")
}

model ImportedCsvLead {
  id                  Int       @id @default(autoincrement())
  importId            Int       @map("import_id")
  clientId            String?   @map("client_id")
  businessName        String    @map("business_name")
  industry            String?
  cityArea            String?   @map("city_area")
  priority            String?
  leadSource          String?   @map("lead_source")
  contactName         String?   @map("contact_name")
  phoneNumber         String?   @map("phone_number")
  email               String?
  socialUrl           String?   @map("social_url")
  status              String?
  packageName         String?   @map("package_name")
  estimatedMonthlyFee String?   @map("estimated_monthly_fee")
  adBudget            String?   @map("ad_budget")
  lastContact         String?   @map("last_contact")
  nextFollowUp        String?   @map("next_follow_up")
  owner               String?
  mainGoal            String?   @map("main_goal")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  import              CsvImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([businessName])
  @@map("imported_csv_leads")
}
