# App Mode
APP_MODE=office_lan_mvp
NODE_ENV=production
APP_PORT=3000
BIND_HOST=0.0.0.0

# Office-only access control
OFFICE_ALLOWED_CIDRS=127.0.0.1/32,::1/128,192.168.0.0/24
BLOCK_PUBLIC_ACCESS=true
TRUST_PROXY=false
REQUIRE_ADMIN_LOGIN=true
COOKIE_SECURE=false

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
SESSION_SECRET=replace_with_long_random_secret

# Serper lead search API (existing Search Collection page)
SERPER_API_KEY=replace_with_serper_api_key
SERPER_PLACES_MAX_PAGES=10

# SME Search feature (Google Places API (New))
# Leave SME_SEARCH_ENABLED unset to control the feature from Settings.
# Set it to true/false to force the flag on or off for this environment.
SME_SEARCH_ENABLED=
# Server-side only. Restrict this key to the Places API in Google Cloud.
GOOGLE_MAPS_API_KEY=replace_with_google_maps_api_key

# Database and export
DATABASE_URL=file:../data/leads.sqlite
EXPORT_DIR=./exports
LOG_DIR=./logs

# Turso (set these in hosted environments; DATABASE_URL remains a local SQLite URL for Prisma CLI generation)
TURSO_DATABASE_URL=libsql://replace_with_turso_database_url
TURSO_AUTH_TOKEN=replace_with_turso_auth_token

# Hosted file storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=replace_with_vercel_blob_read_write_token

# Vercel Cron protection
CRON_SECRET=replace_with_a_long_random_cron_secret

# Email sending
SMTP_HOST=replace_with_smtp_host
SMTP_PORT=587
SMTP_USER=replace_with_smtp_username
SMTP_PASS=replace_with_smtp_or_app_password
SMTP_FROM=replace_with_sender_email
SMTP_FROM_NAME=Lead Collection

# SMS sending (provider-agnostic: movider|twilio|infobip|clicksend|smpp|mock)
SMS_PROVIDER=mock
SMS_API_KEY=replace_with_sms_api_key
SMS_API_SECRET=replace_with_sms_api_secret
SMS_SENDER_ID=replace_with_sms_sender_id

# SMPP sending (used when SMS_PROVIDER=smpp)
SMPP_HOST=replace_with_smpp_host
SMPP_PORT=2775
SMPP_SYSTEM_ID=replace_with_smpp_system_id
SMPP_PASSWORD=replace_with_smpp_password
SMPP_BIND_TYPE=transceiver
SMPP_SOURCE_ADDR=replace_with_default_sender_id
SMPP_SOURCE_ADDR_SMART=replace_with_smart_sender_id
SMPP_SOURCE_ADDR_GLOBE=replace_with_globe_sender_id
SMPP_SOURCE_ADDR_TON=5
SMPP_SOURCE_ADDR_NPI=0
SMPP_DEST_ADDR_TON=1
SMPP_DEST_ADDR_NPI=1
SMPP_REGISTERED_DELIVERY=1
SMPP_TPS=50

# Hosted SMPP worker (recommended for Vercel instead of a persistent SMPP connection in a Function)
SMPP_WORKER_URL=https://replace_with_smpp_worker_url
SMPP_WORKER_API_TOKEN=replace_with_smpp_worker_api_token
SMPP_WORKER_CALLBACK_SECRET=replace_with_smpp_worker_callback_secret
SMPP_DLR_CALLBACK_URL=https://replace_with_hosted_app_url/api/sms/delivery-receipt
SMPP_WORKER_PORT=8080
