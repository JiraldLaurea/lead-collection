{
  "name": "office-lan-lead-collection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prisma:generate": "prisma generate",
    "start": "next start",
    "start:office": "node server.js",
    "start:smpp-worker": "node server/smpp-worker.cjs",
    "dev:tunnel": "next dev -p 3005",
    "tunnel": "ngrok http 3005",
    "tunnel:host-header": "ngrok http 3005 --host-header=localhost:3005",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/init-db.mjs",
    "db:push": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/init-db.mjs",
    "db:rollback:sme": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/rollback-sme.mjs",
    "db:verify:sme": "node scripts/verify-sme-migration.mjs",
    "verify:sme:browser": "node scripts/verify-sme-browser.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:status": "prisma migrate status",
    "env:hosted:sync": "node scripts/sync-hosted-env.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@libsql/client": "^0.17.4",
    "@mui/material": "^9.0.1",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.8.2",
    "@types/nodemailer": "^8.0.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.2",
    "exceljs": "^4.4.0",
    "ipaddr.js": "^2.2.0",
    "next": "^15.3.3",
    "nodemailer": "^8.0.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "smpp": "^0.6.0-rc.4",
    "zod": "^3.25.48"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "docx": "^9.7.1",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "ngrok": "^5.0.0-beta.2",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
